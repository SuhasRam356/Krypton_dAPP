# Optional: enables the Krypton AI assistant API route.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_HTTP_REFERER=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated Gun relay peers used by the browser client.
# Local development default is http://localhost:8765/gun.
NEXT_PUBLIC_GUN_PEERS=http://localhost:8765/gun

# Optional RPC URL offered to MetaMask when adding Sepolia.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Relay server options for `npm run relay`.
PORT=8765
HOST=0.0.0.0
GUN_DATA_DIR=radata
RELAY_CORS_ORIGIN=*
